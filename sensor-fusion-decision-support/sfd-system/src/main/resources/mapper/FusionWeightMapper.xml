<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sursoft.sfd.system.mapper.FusionWeightMapper">
    <resultMap id="RM" type="com.sursoft.sfd.system.domain.FusionWeight">
        <id column="id" property="id"/>
        <result column="scheme_id" property="schemeId"/>
        <result column="rule_id" property="ruleId"/>
        <result column="ds_id" property="dsId"/>
        <result column="ds_name" property="dsName"/>
        <result column="weight_value" property="weightValue"/>
        <result column="adjust_reason" property="adjustReason"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="updated_by" property="updatedBy"/>
    </resultMap>
    <select id="selectBySchemeId" resultMap="RM">
        SELECT fw.*, dc.ds_name FROM fusion_weight fw
        LEFT JOIN datasource_config dc ON fw.ds_id=dc.id
        WHERE fw.scheme_id=#{schemeId}
    </select>
    <select id="selectBySchemeAndRule" resultMap="RM">
        SELECT fw.*, dc.ds_name FROM fusion_weight fw
        LEFT JOIN datasource_config dc ON fw.ds_id=dc.id
        WHERE fw.scheme_id=#{schemeId} AND fw.rule_id=#{ruleId}
    </select>
    <insert id="insert">
        INSERT INTO fusion_weight(id,scheme_id,rule_id,ds_id,weight_value,adjust_reason,updated_at,updated_by)
        VALUES(#{id},#{schemeId},#{ruleId},#{dsId},#{weightValue},#{adjustReason},NOW(),#{updatedBy})
    </insert>
    <update id="update">
        UPDATE fusion_weight SET weight_value=#{weightValue},adjust_reason=#{adjustReason},updated_at=NOW(),updated_by=#{updatedBy}
        WHERE id=#{id}
    </update>
    <delete id="deleteBySchemeId">DELETE FROM fusion_weight WHERE scheme_id=#{schemeId}</delete>
</mapper>
