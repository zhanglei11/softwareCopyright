<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sva.system.mapper.RecognitionResultMapper">
    <resultMap id="BaseRM" type="com.sva.system.domain.RecognitionResult">
        <id column="id" property="id"/>
        <result column="task_id" property="taskId"/>
        <result column="image_id" property="imageId"/>
        <result column="review_status" property="reviewStatus"/>
        <result column="reviewed_by" property="reviewedBy"/>
        <result column="reviewed_at" property="reviewedAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="image_no" property="imageNo"/>
        <result column="file_name" property="fileName"/>
        <result column="task_name" property="taskName"/>
        <result column="box_count" property="boxCount"/>
    </resultMap>
    <resultMap id="BoxRM" type="com.sva.system.domain.RecognitionBox">
        <id column="id" property="id"/>
        <result column="result_id" property="resultId"/>
        <result column="x" property="x"/>
        <result column="y" property="y"/>
        <result column="width" property="width"/>
        <result column="height" property="height"/>
        <result column="label" property="label"/>
        <result column="confidence" property="confidence"/>
        <result column="source" property="source"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>
    <select id="selectList" resultMap="BaseRM">
        SELECT rr.*, img.image_no, img.file_name, rt.task_name,
               (SELECT COUNT(*) FROM recognition_box rb WHERE rb.result_id=rr.id AND rb.is_deleted=0) AS box_count
        FROM recognition_result rr
        LEFT JOIN image_file img ON img.id=rr.image_id
        LEFT JOIN recognition_task rt ON rt.id=rr.task_id
        WHERE 1=1
        <if test="taskId != null">AND rr.task_id=#{taskId}</if>
        <if test="reviewStatus != null">AND rr.review_status=#{reviewStatus}</if>
        ORDER BY rr.created_at DESC
    </select>
    <select id="selectById" resultMap="BaseRM">SELECT * FROM recognition_result WHERE id=#{id}</select>
    <update id="update">UPDATE recognition_result SET review_status=#{reviewStatus},reviewed_by=#{reviewedBy},reviewed_at=#{reviewedAt},updated_at=NOW() WHERE id=#{id}</update>
    <select id="selectBoxesByResultId" resultMap="BoxRM">SELECT * FROM recognition_box WHERE result_id=#{resultId} AND is_deleted=0</select>
    <insert id="insertBox" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO recognition_box(result_id,x,y,width,height,label,confidence,source,is_deleted,updated_at)
        VALUES(#{resultId},#{x},#{y},#{width},#{height},#{label},#{confidence},#{source},0,NOW())
    </insert>
    <update id="updateBox">UPDATE recognition_box SET label=#{label},x=#{x},y=#{y},width=#{width},height=#{height},updated_by=#{updatedBy},updated_at=NOW() WHERE id=#{id} AND result_id=#{resultId}</update>
    <update id="deleteBoxById">UPDATE recognition_box SET is_deleted=1,updated_at=NOW() WHERE id=#{id} AND result_id=#{resultId}</update>
    <update id="batchUpdateReviewStatus">
        UPDATE recognition_result SET review_status=#{reviewStatus},updated_at=NOW()
        WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>
</mapper>
