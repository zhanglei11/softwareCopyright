<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sva.system.mapper.ImageFileMapper">
    <resultMap id="BaseRM" type="com.sva.system.domain.ImageFile">
        <id column="id" property="id"/>
        <result column="image_no" property="imageNo"/>
        <result column="file_name" property="fileName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_format" property="fileFormat"/>
        <result column="file_size" property="fileSize"/>
        <result column="category_id" property="categoryId"/>
        <result column="recognition_status" property="recognitionStatus"/>
        <result column="remark" property="remark"/>
        <result column="uploaded_by" property="uploadedBy"/>
        <result column="uploaded_at" property="uploadedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>
    <select id="selectList" resultMap="BaseRM">
        SELECT * FROM image_file WHERE deleted=0
        <if test="categoryId != null">AND category_id=#{categoryId}</if>
        <if test="fileName != null and fileName != ''">AND file_name LIKE CONCAT('%',#{fileName},'%')</if>
        <if test="recognitionStatus != null">AND recognition_status=#{recognitionStatus}</if>
        ORDER BY uploaded_at DESC
    </select>
    <select id="selectById" resultMap="BaseRM">SELECT * FROM image_file WHERE id=#{id} AND deleted=0</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO image_file(image_no,file_name,file_path,file_format,file_size,category_id,recognition_status,remark,uploaded_by,uploaded_at,deleted)
        VALUES(#{imageNo},#{fileName},#{filePath},#{fileFormat},#{fileSize},#{categoryId},0,#{remark},#{uploadedBy},NOW(),0)
    </insert>
    <update id="deleteById">UPDATE image_file SET deleted=1 WHERE id=#{id}</update>
    <select id="selectByCategoryIds" resultMap="BaseRM">
        SELECT * FROM image_file WHERE deleted=0 AND category_id IN
        <foreach collection="categoryIds" item="cid" open="(" separator="," close=")">#{cid}</foreach>
    </select>
    <select id="countByTaskId" resultType="int">
        SELECT COUNT(*) FROM task_image_rel WHERE image_id=#{taskId}
    </select>
    <update id="updateRecognitionStatus">UPDATE image_file SET recognition_status=#{status} WHERE id=#{id}</update>
</mapper>
