<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.angu.matcher.system.mapper.ResumeWorkExpMapper">
    <resultMap id="expMap" type="com.angu.matcher.system.domain.ResumeWorkExp">
        <id property="id" column="id"/>
        <result property="resumeId" column="resume_id"/>
        <result property="company" column="company"/>
        <result property="position" column="position"/>
        <result property="industry" column="industry"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="description" column="description"/>
    </resultMap>

    <select id="selectByResumeId" resultMap="expMap">
        SELECT * FROM resume_work_exp WHERE resume_id=#{resumeId} ORDER BY start_date DESC
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO resume_work_exp(resume_id,company,position,industry,start_date,end_date,description)
        VALUES(#{resumeId},#{company},#{position},#{industry},#{startDate},#{endDate},#{description})
    </insert>
    <delete id="deleteByResumeId">DELETE FROM resume_work_exp WHERE resume_id=#{resumeId}</delete>
</mapper>
