<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sursoft.vision.system.mapper.LineInfoMapper">
    <resultMap id="RM" type="com.sursoft.vision.system.domain.LineInfo">
        <id property="id" column="id"/>
        <result property="lineNo" column="line_no"/>
        <result property="lineName" column="line_name"/>
        <result property="workshop" column="workshop"/>
        <result property="managerId" column="manager_id"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>
    <select id="selectById" resultMap="RM">SELECT * FROM line_info WHERE id=#{id} AND is_deleted=0</select>
    <select id="selectByLineNo" resultMap="RM">SELECT * FROM line_info WHERE line_no=#{lineNo} AND is_deleted=0</select>
    <select id="selectList" resultMap="RM">
        SELECT * FROM line_info WHERE is_deleted=0
        <if test="lineName != null and lineName != ''">AND line_name LIKE CONCAT('%',#{lineName},'%')</if>
        <if test="status != null">AND status=#{status}</if>
        ORDER BY created_at DESC
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO line_info(line_no,line_name,workshop,manager_id,status,remark,is_deleted,created_at)
        VALUES(#{lineNo},#{lineName},#{workshop},#{managerId},#{status},#{remark},0,NOW())
    </insert>
    <update id="updateById">
        UPDATE line_info <set>
            <if test="lineName != null">line_name=#{lineName},</if>
            <if test="workshop != null">workshop=#{workshop},</if>
            <if test="managerId != null">manager_id=#{managerId},</if>
            <if test="status != null">status=#{status},</if>
            <if test="remark != null">remark=#{remark},</if>
            <if test="isDeleted != null">is_deleted=#{isDeleted},</if>
            updated_at=NOW()
        </set> WHERE id=#{id}
    </update>
    <delete id="deleteById">UPDATE line_info SET is_deleted=1 WHERE id=#{id}</delete>
</mapper>
