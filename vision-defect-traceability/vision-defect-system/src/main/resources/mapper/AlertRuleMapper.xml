<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sursoft.vision.system.mapper.AlertRuleMapper">
    <resultMap id="RM" type="com.sursoft.vision.system.domain.AlertRule">
        <id property="id" column="id"/>
        <result property="ruleName" column="rule_name"/>
        <result property="lineId" column="line_id"/>
        <result property="conditionType" column="condition_type"/>
        <result property="threshold" column="threshold"/>
        <result property="statCycle" column="stat_cycle"/>
        <result property="alertLevel" column="alert_level"/>
        <result property="notifyUserIds" column="notify_user_ids"/>
        <result property="status" column="status"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>
    <select id="selectById" resultMap="RM">SELECT * FROM alert_rule WHERE id=#{id} AND is_deleted=0</select>
    <select id="selectList" resultMap="RM">
        SELECT * FROM alert_rule WHERE is_deleted=0
        <if test="status != null">AND status=#{status}</if>
        ORDER BY created_at DESC
    </select>
    <select id="selectEnabledRules" resultMap="RM">SELECT * FROM alert_rule WHERE status=1 AND is_deleted=0</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO alert_rule(rule_name,line_id,condition_type,threshold,stat_cycle,alert_level,notify_user_ids,status,is_deleted,created_at,created_by)
        VALUES(#{ruleName},#{lineId},#{conditionType},#{threshold},#{statCycle},#{alertLevel},#{notifyUserIds},#{status},0,NOW(),#{createdBy})
    </insert>
    <update id="updateById">
        UPDATE alert_rule <set>
            <if test="ruleName != null">rule_name=#{ruleName},</if>
            <if test="lineId != null">line_id=#{lineId},</if>
            <if test="conditionType != null">condition_type=#{conditionType},</if>
            <if test="threshold != null">threshold=#{threshold},</if>
            <if test="statCycle != null">stat_cycle=#{statCycle},</if>
            <if test="alertLevel != null">alert_level=#{alertLevel},</if>
            <if test="notifyUserIds != null">notify_user_ids=#{notifyUserIds},</if>
            <if test="status != null">status=#{status},</if>
            <if test="isDeleted != null">is_deleted=#{isDeleted},</if>
            updated_at=NOW()
        </set> WHERE id=#{id}
    </update>
    <delete id="deleteById">UPDATE alert_rule SET is_deleted=1 WHERE id=#{id}</delete>
</mapper>
