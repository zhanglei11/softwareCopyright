<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sursoft.vision.system.mapper.SysRoleMapper">

    <resultMap id="roleMap" type="com.sursoft.vision.system.domain.SysRole">
        <id property="id" column="id"/>
        <result property="roleName" column="role_name"/>
        <result property="roleKey" column="role_key"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
    </resultMap>

    <select id="selectById" resultMap="roleMap">SELECT * FROM sys_role WHERE id=#{id} AND is_deleted=0</select>

    <select id="selectList" resultMap="roleMap">
        SELECT * FROM sys_role WHERE is_deleted=0
        <if test="roleName != null and roleName != ''">AND role_name LIKE CONCAT('%',#{roleName},'%')</if>
        <if test="status != null">AND status=#{status}</if>
        ORDER BY created_at DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_role(role_name,role_key,status,remark,is_deleted,created_at)
        VALUES(#{roleName},#{roleKey},#{status},#{remark},0,NOW())
    </insert>

    <update id="updateById">
        UPDATE sys_role
        <set>
            <if test="roleName != null">role_name=#{roleName},</if>
            <if test="roleKey != null">role_key=#{roleKey},</if>
            <if test="status != null">status=#{status},</if>
            <if test="remark != null">remark=#{remark},</if>
            <if test="isDeleted != null">is_deleted=#{isDeleted},</if>
        </set>
        WHERE id=#{id}
    </update>

    <delete id="deleteById">UPDATE sys_role SET is_deleted=1 WHERE id=#{id}</delete>

    <insert id="insertRoleMenus">
        INSERT INTO sys_role_menu(role_id,menu_id) VALUES
        <foreach collection="menuIds" item="menuId" separator=",">
            (#{roleId},#{menuId})
        </foreach>
    </insert>

    <delete id="deleteRoleMenus">DELETE FROM sys_role_menu WHERE role_id=#{roleId}</delete>
</mapper>
