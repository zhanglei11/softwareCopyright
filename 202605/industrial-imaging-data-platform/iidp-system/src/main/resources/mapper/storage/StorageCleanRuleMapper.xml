<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sursoft.iidp.system.storage.mapper.StorageCleanRuleMapper">
    <resultMap id="RuleMap" type="com.sursoft.iidp.system.storage.domain.StorageCleanRule">
        <id property="id" column="id"/>
        <result property="ruleName" column="rule_name"/>
        <result property="targetDir" column="target_dir"/>
        <result property="conditionType" column="condition_type"/>
        <result property="conditionValue" column="condition_value"/>
        <result property="executeType" column="execute_type"/>
        <result property="cronExpression" column="cron_expression"/>
        <result property="afterAction" column="after_action"/>
        <result property="archiveDir" column="archive_dir"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>
    <select id="selectList" resultMap="RuleMap">
        SELECT * FROM storage_clean_rule
        <where>
            is_deleted = 0
            <if test="ruleName != null and ruleName != ''">AND rule_name LIKE CONCAT('%', #{ruleName}, '%')</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY created_at DESC
    </select>
    <select id="selectById" resultMap="RuleMap">SELECT * FROM storage_clean_rule WHERE id = #{id} AND is_deleted = 0</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO storage_clean_rule(rule_name,target_dir,condition_type,condition_value,
        execute_type,cron_expression,after_action,archive_dir,status,remark,created_by,updated_by)
        VALUES(#{ruleName},#{targetDir},#{conditionType},#{conditionValue},
        #{executeType},#{cronExpression},#{afterAction},#{archiveDir},#{status},#{remark},#{createdBy},#{updatedBy})
    </insert>
    <update id="update">
        UPDATE storage_clean_rule
        <set>
            <if test="ruleName != null">rule_name = #{ruleName},</if>
            <if test="targetDir != null">target_dir = #{targetDir},</if>
            <if test="conditionType != null">condition_type = #{conditionType},</if>
            <if test="conditionValue != null">condition_value = #{conditionValue},</if>
            <if test="afterAction != null">after_action = #{afterAction},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>
    <delete id="deleteById">UPDATE storage_clean_rule SET is_deleted = 1, updated_at = NOW() WHERE id = #{id}</delete>
    <update id="updateStatus">UPDATE storage_clean_rule SET status = #{status}, updated_at = NOW() WHERE id = #{id}</update>
</mapper>
