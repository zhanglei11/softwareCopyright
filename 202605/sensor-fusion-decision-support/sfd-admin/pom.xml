<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sursoft</groupId>
    <artifactId>sensor-fusion-decision-support</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>sfd-admin</artifactId>
  <name>sfd-admin</name>
  <description>Web暴露层：启动入口、Controller</description>
  <dependencies>
    <dependency>
      <groupId>com.sursoft</groupId>
      <artifactId>sfd-framework</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sursoft</groupId>
      <artifactId>sfd-system</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>com.sursoft.sfd.SfdApplication</mainClass>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
