<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sursoft.sfd.system.mapper.SysMenuMapper">
    <resultMap id="BaseResultMap" type="com.sursoft.sfd.system.domain.SysMenu">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="menu_name" property="menuName"/>
        <result column="menu_type" property="menuType"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="icon" property="icon"/>
        <result column="permission" property="permission"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="remark" property="remark"/>
    </resultMap>
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM sys_menu WHERE is_deleted = 0 ORDER BY sort, id
    </select>
    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM sys_menu WHERE id = #{id} AND is_deleted = 0
    </select>
    <select id="selectMenusByUserId" resultMap="BaseResultMap">
        SELECT DISTINCT m.* FROM sys_menu m
        INNER JOIN sys_role_menu rm ON m.id = rm.menu_id
        INNER JOIN sys_user_role ur ON rm.role_id = ur.role_id
        WHERE ur.user_id = #{userId} AND m.status = 1 AND m.is_deleted = 0
        ORDER BY m.sort, m.id
    </select>
    <insert id="insert">
        INSERT INTO sys_menu (id,parent_id,menu_name,menu_type,path,component,icon,permission,sort,status,is_deleted,created_at,created_by)
        VALUES (#{id},#{parentId},#{menuName},#{menuType},#{path},#{component},#{icon},#{permission},#{sort},#{status},0,NOW(),#{createdBy})
    </insert>
    <update id="update">
        UPDATE sys_menu SET menu_name=#{menuName},menu_type=#{menuType},path=#{path},component=#{component},
        icon=#{icon},permission=#{permission},sort=#{sort},status=#{status},updated_at=NOW(),updated_by=#{updatedBy}
        WHERE id=#{id}
    </update>
    <update id="deleteById">
        UPDATE sys_menu SET is_deleted=1,updated_at=NOW() WHERE id=#{id}
    </update>
    <select id="countChildren" resultType="int">
        SELECT COUNT(*) FROM sys_menu WHERE parent_id=#{parentId} AND is_deleted=0
    </select>
</mapper>
