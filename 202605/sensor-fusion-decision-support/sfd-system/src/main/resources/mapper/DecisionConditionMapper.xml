<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sursoft.sfd.system.mapper.DecisionConditionMapper">
    <resultMap id="RM" type="com.sursoft.sfd.system.domain.DecisionCondition">
        <id column="id" property="id"/>
        <result column="condition_name" property="conditionName"/>
        <result column="condition_field" property="conditionField"/>
        <result column="operator" property="operator"/>
        <result column="threshold_value" property="thresholdValue"/>
        <result column="threshold_value2" property="thresholdValue2"/>
        <result column="description" property="description"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="updated_by" property="updatedBy"/>
    </resultMap>
    <select id="selectList" resultMap="RM">
        SELECT * FROM decision_condition WHERE is_deleted=0
        <if test="keyword != null and keyword != ''">AND condition_name LIKE CONCAT('%',#{keyword},'%')</if>
        ORDER BY id DESC
    </select>
    <select id="selectById" resultMap="RM">SELECT * FROM decision_condition WHERE id=#{id} AND is_deleted=0</select>
    <insert id="insert">
        INSERT INTO decision_condition(id,condition_name,condition_field,operator,threshold_value,threshold_value2,description,is_deleted,created_at,created_by)
        VALUES(#{id},#{conditionName},#{conditionField},#{operator},#{thresholdValue},#{thresholdValue2},#{description},0,NOW(),#{createdBy})
    </insert>
    <update id="update">
        UPDATE decision_condition SET condition_name=#{conditionName},condition_field=#{conditionField},
        operator=#{operator},threshold_value=#{thresholdValue},threshold_value2=#{thresholdValue2},
        description=#{description},updated_at=NOW(),updated_by=#{updatedBy} WHERE id=#{id}
    </update>
    <update id="deleteById">UPDATE decision_condition SET is_deleted=1,updated_at=NOW() WHERE id=#{id}</update>
</mapper>
