<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sursoft.sfd.system.mapper.DecisionRuleMapper">
    <resultMap id="RM" type="com.sursoft.sfd.system.domain.DecisionRule">
        <id column="id" property="id"/>
        <result column="rule_code" property="ruleCode"/>
        <result column="rule_name" property="ruleName"/>
        <result column="scheme_id" property="schemeId"/>
        <result column="scheme_name" property="schemeName"/>
        <result column="trigger_condition" property="triggerCondition"/>
        <result column="decision_output" property="decisionOutput"/>
        <result column="priority" property="priority"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="remark" property="remark"/>
    </resultMap>
    <select id="selectList" resultMap="RM">
        SELECT dr.*, fs.scheme_name FROM decision_rule dr
        LEFT JOIN fusion_scheme fs ON dr.scheme_id=fs.id
        WHERE dr.is_deleted=0
        <if test="schemeId != null">AND dr.scheme_id=#{schemeId}</if>
        <if test="status != null">AND dr.status=#{status}</if>
        <if test="keyword != null and keyword != ''">AND dr.rule_name LIKE CONCAT('%',#{keyword},'%')</if>
        ORDER BY dr.priority ASC
    </select>
    <select id="selectById" resultMap="RM">
        SELECT dr.*, fs.scheme_name FROM decision_rule dr
        LEFT JOIN fusion_scheme fs ON dr.scheme_id=fs.id
        WHERE dr.id=#{id} AND dr.is_deleted=0
    </select>
    <select id="selectEnabledBySchemeId" resultMap="RM">
        SELECT * FROM decision_rule WHERE scheme_id=#{schemeId} AND status=1 AND is_deleted=0 ORDER BY priority ASC
    </select>
    <insert id="insert">
        INSERT INTO decision_rule(id,rule_code,rule_name,scheme_id,trigger_condition,decision_output,priority,status,is_deleted,created_at,created_by,remark)
        VALUES(#{id},#{ruleCode},#{ruleName},#{schemeId},#{triggerCondition},#{decisionOutput},#{priority},#{status},0,NOW(),#{createdBy},#{remark})
    </insert>
    <update id="update">
        UPDATE decision_rule SET rule_name=#{ruleName},scheme_id=#{schemeId},trigger_condition=#{triggerCondition},
        decision_output=#{decisionOutput},priority=#{priority},remark=#{remark},updated_at=NOW(),updated_by=#{updatedBy}
        WHERE id=#{id}
    </update>
    <update id="deleteById">UPDATE decision_rule SET is_deleted=1,updated_at=NOW() WHERE id=#{id}</update>
    <update id="updateStatus">UPDATE decision_rule SET status=#{status},updated_at=NOW(),updated_by=#{updatedBy} WHERE id=#{id}</update>
</mapper>
