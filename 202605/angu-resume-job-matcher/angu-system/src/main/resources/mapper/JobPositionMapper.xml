<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.angu.matcher.system.mapper.JobPositionMapper">

    <resultMap id="positionMap" type="com.angu.matcher.system.domain.JobPosition">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="department" column="department"/>
        <result property="jobType" column="job_type"/>
        <result property="location" column="location"/>
        <result property="salaryMin" column="salary_min"/>
        <result property="salaryMax" column="salary_max"/>
        <result property="eduRequire" column="edu_require"/>
        <result property="expRequire" column="exp_require"/>
        <result property="description" column="description"/>
        <result property="skillTags" column="skill_tags"/>
        <result property="status" column="status"/>
        <result property="deleted" column="deleted"/>
        <result property="creatorId" column="creator_id"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
    </resultMap>

    <select id="selectList" resultMap="positionMap">
        SELECT * FROM job_position WHERE deleted = 0
        <if test="title != null and title != ''">AND title LIKE CONCAT('%',#{title},'%')</if>
        <if test="department != null and department != ''">AND department = #{department}</if>
        <if test="status != null and status != ''">AND status = #{status}</if>
        <if test="jobType != null and jobType != ''">AND job_type = #{jobType}</if>
        <if test="eduRequire != null and eduRequire != ''">AND edu_require = #{eduRequire}</if>
        ORDER BY created_time DESC
    </select>

    <select id="selectById" resultMap="positionMap">
        SELECT * FROM job_position WHERE id=#{id} AND deleted=0
    </select>

    <select id="countApplicationsByPositionId" resultType="int">
        SELECT COUNT(*) FROM job_application WHERE position_id=#{id}
    </select>

    <select id="selectOpenPositions" resultMap="positionMap">
        SELECT * FROM job_position WHERE status='OPEN' AND deleted=0
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO job_position(title,department,job_type,location,salary_min,salary_max,
        edu_require,exp_require,description,skill_tags,status,deleted,creator_id,created_time,updated_time)
        VALUES(#{title},#{department},#{jobType},#{location},#{salaryMin},#{salaryMax},
        #{eduRequire},#{expRequire},#{description},#{skillTags},'DRAFT',0,#{creatorId},NOW(),NOW())
    </insert>

    <update id="update">
        UPDATE job_position SET title=#{title},department=#{department},job_type=#{jobType},
        location=#{location},salary_min=#{salaryMin},salary_max=#{salaryMax},
        edu_require=#{eduRequire},exp_require=#{expRequire},description=#{description},
        skill_tags=#{skillTags},status=#{status},updated_time=NOW()
        WHERE id=#{id} AND deleted=0
    </update>

    <update id="deleteById">
        UPDATE job_position SET deleted=1,updated_time=NOW() WHERE id=#{id}
    </update>

</mapper>
