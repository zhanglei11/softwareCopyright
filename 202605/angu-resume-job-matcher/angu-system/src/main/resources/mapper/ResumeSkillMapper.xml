<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.angu.matcher.system.mapper.ResumeSkillMapper">
    <resultMap id="skillMap" type="com.angu.matcher.system.domain.ResumeSkill">
        <id property="id" column="id"/>
        <result property="resumeId" column="resume_id"/>
        <result property="skillName" column="skill_name"/>
    </resultMap>
    <select id="selectByResumeId" resultMap="skillMap">
        SELECT * FROM resume_skill WHERE resume_id=#{resumeId}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO resume_skill(resume_id,skill_name) VALUES(#{resumeId},#{skillName})
    </insert>
    <delete id="deleteByResumeId">DELETE FROM resume_skill WHERE resume_id=#{resumeId}</delete>
</mapper>
