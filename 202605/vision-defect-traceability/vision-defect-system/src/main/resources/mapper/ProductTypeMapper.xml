<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sursoft.vision.system.mapper.ProductTypeMapper">
    <resultMap id="RM" type="com.sursoft.vision.system.domain.ProductType">
        <id property="id" column="id"/>
        <result property="typeNo" column="type_no"/>
        <result property="typeName" column="type_name"/>
        <result property="lineId" column="line_id"/>
        <result property="status" column="status"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createdAt" column="created_at"/>
        <result property="createdBy" column="created_by"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="updatedBy" column="updated_by"/>
    </resultMap>
    <select id="selectById" resultMap="RM">SELECT * FROM product_type WHERE id=#{id} AND is_deleted=0</select>
    <select id="selectList" resultMap="RM">
        SELECT * FROM product_type WHERE is_deleted=0
        <if test="lineId != null">AND line_id=#{lineId}</if>
        <if test="status != null">AND status=#{status}</if>
        ORDER BY created_at DESC
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_type(type_no,type_name,line_id,status,is_deleted,created_at)
        VALUES(#{typeNo},#{typeName},#{lineId},#{status},0,NOW())
    </insert>
    <update id="updateById">
        UPDATE product_type <set>
            <if test="typeName != null">type_name=#{typeName},</if>
            <if test="lineId != null">line_id=#{lineId},</if>
            <if test="status != null">status=#{status},</if>
            <if test="isDeleted != null">is_deleted=#{isDeleted},</if>
            updated_at=NOW()
        </set> WHERE id=#{id}
    </update>
    <delete id="deleteById">UPDATE product_type SET is_deleted=1 WHERE id=#{id}</delete>
</mapper>
