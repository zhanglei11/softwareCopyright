<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sursoft.vision.system.mapper.AlertRecordMapper">
    <resultMap id="RM" type="com.sursoft.vision.system.domain.AlertRecord">
        <id property="id" column="id"/>
        <result property="ruleId" column="rule_id"/>
        <result property="alertContent" column="alert_content"/>
        <result property="alertTime" column="alert_time"/>
        <result property="handleStatus" column="handle_status"/>
        <result property="handleRemark" column="handle_remark"/>
        <result property="handleBy" column="handle_by"/>
        <result property="handleAt" column="handle_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>
    <select id="selectById" resultMap="RM">SELECT * FROM alert_record WHERE id=#{id}</select>
    <select id="selectList" resultMap="RM">
        SELECT * FROM alert_record WHERE 1=1
        <if test="ruleId != null">AND rule_id=#{ruleId}</if>
        <if test="handleStatus != null">AND handle_status=#{handleStatus}</if>
        <if test="startTime != null and startTime != ''">AND alert_time &gt;= #{startTime}</if>
        <if test="endTime != null and endTime != ''">AND alert_time &lt;= #{endTime}</if>
        ORDER BY alert_time DESC
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO alert_record(rule_id,alert_content,alert_time,handle_status,created_at)
        VALUES(#{ruleId},#{alertContent},#{alertTime},0,NOW())
    </insert>
    <update id="updateById">
        UPDATE alert_record SET handle_status=#{handleStatus},handle_remark=#{handleRemark},handle_by=#{handleBy},handle_at=#{handleAt}
        WHERE id=#{id}
    </update>
</mapper>
